    border-color: rgb(251 191 36 / 0.18);
    transform: translateZ(4px) rotate(17deg);
    animation: hero-orbit-spin 18s linear reverse infinite;
  }

  .hero-showcase__shadow {
    position: absolute;
    left: 9%;
    right: 5%;
    bottom: 8%;
    height: 18%;
    border-radius: 999px;
    background: radial-gradient(ellipse, rgb(0 0 0 / 0.66), transparent 70%);
    filter: blur(14px);
    transform: rotateX(74deg) translateZ(-52px);
  }

  .hero-showcase__burger {
    position: absolute;
    inset: 0;
    z-index: 2;
    transform: translateZ(92px);
    transform-style: preserve-3d;
    animation: hero-burger-float 7.5s ease-in-out infinite;
  }

  .hero-showcase__main {
    z-index: 2;
    padding: clamp(0rem, 2vw, 1rem);
    transform: scale(1.16);
    filter:
      drop-shadow(0 36px 30px rgb(0 0 0 / 0.42)) drop-shadow(0 4px 0 rgb(251 191 36 / 0.12));
  }

  .hero-showcase__shine {
    position: absolute;
    inset: 9% 10% 13%;
    z-index: 3;
    border-radius: 999px;
    background: radial-gradient(circle at 55% 36%,
        rgb(255 255 255 / 0.3),
        transparent 30%);
    mix-blend-mode: screen;
    opacity: 0.75;
    pointer-events: none;
    transform: translateZ(118px);
  }

  .hero-showcase__depth {
    position: absolute;
    z-index: 1;
    border-radius: 999px;
    pointer-events: none;
    transform: translateZ(54px);
  }

  .hero-showcase__depth--one {
    inset: 17% 8% 20%;
    background: radial-gradient(ellipse, rgb(251 191 36 / 0.18), transparent 66%);
    filter: blur(18px);
  }

  .hero-showcase__depth--two {
    inset: 34% 1% 12% 12%;
    border: 1px solid rgb(255 255 255 / 0.12);
    transform: translateZ(70px) rotate(-9deg);
  }

  .hero-mini-card {
    position: absolute;
    z-index: 5;
    display: flex;
    max-width: 240px;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 8px;
    background: rgb(19 7 5 / 0.62);
    padding: 0.65rem;
    color: #fff7ed;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.14),
      0 18px 44px rgb(0 0 0 / 0.32);
    backdrop-filter: blur(18px);
    animation: garnish-float 6.5s ease-in-out infinite;
  }

  .hero-mini-card--chicken {
    top: 18%;
    left: 0;
    transform: translateZ(148px) rotate(-2deg);
  }

  .hero-mini-card--fries {
    right: 4%;
    bottom: 13%;
    transform: translateZ(136px) rotate(2deg);
    animation-delay: -2.4s;
  }

  .hero-mini-card__image {
    position: relative;
    width: 4.75rem;
    aspect-ratio: 1;
    flex: 0 0 auto;
    overflow: hidden;
    border-radius: 8px;
    background: #2b1008;
  }

  .hero-mini-card__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: #fcd34d;
    font-size: 0.72rem;
    font-weight: 950;
    text-transform: uppercase;
  }

  .hero-mini-card__title {
    margin-top: 0.2rem;
    color: #fff7ed;
    font-size: 0.98rem;
    font-weight: 950;
    line-height: 1.05;
    text-transform: uppercase;
  }

  @keyframes hero-burger-float {

    0%,
    100% {
      translate: 0 0;
    }

    50% {
      translate: 0 -14px;
    }
  }

  @keyframes hero-glow-breathe {

    0%,
    100% {
      opacity: 0.9;
      transform: translateZ(-70px) rotate(-8deg) scale(1);
    }

    50% {
      opacity: 0.76;
      transform: translateZ(-70px) rotate(-8deg) scale(0.98);
    }
  }

  @keyframes hero-orbit-spin {
    0% {
      rotate: 0deg;
    }

    100% {
      rotate: 360deg;
    }
  }

  @keyframes garnish-float {

    0%,
    100% {
      translate: 0 0;
    }

    50% {
      translate: 0 -10px;
    }
  }

  @keyframes hero-steam-rise {
    0% {
      opacity: 0;
      translate: 0 18px;
    }

    35% {
      opacity: 0.72;
    }

    100% {
      opacity: 0;
      translate: 0 -26px;
    }
  }

  @media (max-width: 640px) {
    .hero-showcase {
      touch-action: auto;
    }

    .hero-showcase__rig {
      inset: 5% -18% 10% -18%;
    }

    .hero-showcase__burger {
      transform: translateZ(64px);
    }

    .hero-showcase__main {
      transform: scale(1.12);
    }

    .hero-showcase__orbit--one,
    .hero-showcase__orbit--two {
      inset: 15% -12% 24%;
    }

    .hero-price-badge {
      top: 8%;
      right: 0;
      scale: 0.9;
    }
  }
}
</file>

