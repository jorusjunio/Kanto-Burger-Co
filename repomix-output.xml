  {
    categorySlug: "fries-and-sides",
    name: "Kanto Fries",
    slug: "kanto-fries",
    description: "Golden fries with house seasoning.",
    price: "69.00",
    imageUrl: "/assets/products/Fries.png",
    stockQuantity: 45,
    lowStockThreshold: 10,
    addOns: [
      { name: "Cheese Dip", price: "20.00" },
      { name: "Garlic Mayo", price: "15.00" },
