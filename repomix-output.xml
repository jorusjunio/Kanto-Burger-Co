                        {order.deliveryAddress}
                      </dd>
                    </div>
                  ) : null}
                  {order.notes ? (
                    <div>
                      <dt className="text-zinc-500">Order notes</dt>
                      <dd className="font-bold text-zinc-950">{order.notes}</dd>
