@layer base {
  * {
    @apply border-border outline-ring/50;
  }

  html {
    @apply font-sans;
    scroll-behavior: smooth;
  }

  body {
    @apply bg-background text-foreground;
  }

  ::selection {
    background: rgb(251 191 36 / 0.42);
    color: #7f1d1d;
  }

  /* Hide scrollbar track entirely — scroll still works */
  html,
  body,
  * {
    scrollbar-width: none !important;
    /* Firefox */
  }

  ::-webkit-scrollbar {
    display: none !important;
    /* Chrome, Safari, Edge */
    width: 0 !important;
    height: 0 !important;
  }

  ::-webkit-scrollbar-track {
    display: none !important;
    background: transparent !important;
  }

  ::-webkit-scrollbar-thumb {
    display: none !important;
  }
}

@layer components {
  /* ─────────────────────────────────────────────
     CINEMATIC PAGE LOADER — 144fps smooth
  ───────────────────────────────────────────── */
  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: opacity, transform;
    backface-visibility: hidden;
    animation: loader-enter 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* Phase: exit — cinematic scale-up + fade */
  .page-loader[data-phase="exit"],
  .page-loader[data-phase="done"] {
    pointer-events: none;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 1000ms cubic-bezier(0.4, 0, 0, 1),
      transform 1000ms cubic-bezier(0.4, 0, 0, 1);
  }

  @keyframes loader-enter {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Backdrop — dark with warm radials */
  .page-loader__backdrop {
    position: absolute;
    inset: 0;
    will-change: transform;
    backface-visibility: hidden;
    background:
      radial-gradient(ellipse 60% 50% at 62% 38%, rgba(251, 191, 36, 0.13), transparent),
      radial-gradient(ellipse 45% 45% at 12% 72%, rgba(220, 38, 38, 0.09), transparent),
      linear-gradient(160deg, #0e0402, #1c0806 60%, #0b0302);
  }

  /* Center lockup — logo + tagline */
  .page-loader__center {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    will-change: opacity, transform;
    backface-visibility: hidden;
    animation: loader-rise 620ms cubic-bezier(0.34, 1.56, 0.64, 1) 40ms both;
  }

  @keyframes loader-rise {
    from {
      opacity: 0;
      transform: translateY(22px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .page-loader__logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    font-weight: 950;
    will-change: transform;
    backface-visibility: hidden;
    /* Gentle breathing while loading */
    animation: loader-breathe 2.6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  @keyframes loader-breathe {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.025);
    }
  }

  .page-loader__logo-kanto {
    font-size: clamp(3rem, 8vw, 5.5rem);
    color: #fbbf24;
    text-shadow:
      0 0 48px rgba(251, 191, 36, 0.5),
      0 0 96px rgba(251, 191, 36, 0.2),
      0 2px 24px rgba(0, 0, 0, 0.4);
    /* Glow pulse synced with breathe */
    animation: loader-glow 2.6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  @keyframes loader-glow {
    0%, 100% {
      text-shadow:
        0 0 48px rgba(251, 191, 36, 0.5),
        0 0 96px rgba(251, 191, 36, 0.2),
        0 2px 24px rgba(0, 0, 0, 0.4);
    }
    50% {
      text-shadow:
        0 0 64px rgba(251, 191, 36, 0.7),
        0 0 120px rgba(251, 191, 36, 0.3),
        0 2px 24px rgba(0, 0, 0, 0.4);
    }
  }

  .page-loader__logo-burger {
    font-size: clamp(1.05rem, 2.8vw, 1.75rem);
    color: rgba(255, 237, 213, 0.72);
    letter-spacing: 0.22em;
    font-weight: 800;
    text-transform: uppercase;
  }

  .page-loader__tagline {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(251, 191, 36, 0.45);
    will-change: opacity, transform;
    backface-visibility: hidden;
    animation: loader-tagline 700ms cubic-bezier(0.22, 1, 0.36, 1) 160ms both;
  }

  @keyframes loader-tagline {
    from {
      opacity: 0;
      transform: translateY(6px);
      letter-spacing: 0.06em;
    }
    to {
      opacity: 1;
      transform: translateY(0);
      letter-spacing: 0.18em;
    }
  }

  /* Progress bar — GPU-only with scaleX transform */
  .page-loader__track {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }

  .page-loader__bar {
    width: 100%;
    height: 100%;
    transform-origin: left center;
    will-change: transform;
    backface-visibility: hidden;
    background: linear-gradient(90deg, #f59e0b, #fbbf24 50%, #fcd34d);
    box-shadow:
      0 0 18px rgba(251, 191, 36, 0.7),
      0 0 6px rgba(251, 191, 36, 0.4);
    border-radius: 0 2px 2px 0;
    /* No CSS transition — driven by rAF in JS for jank-free 144fps */
  }

  /* ─────────────────────────────────────────────
     PAGE LOADER — MENU VARIANT OVERRIDES
  ───────────────────────────────────────────── */
  .page-loader[data-variant="menu"] .page-loader__backdrop {
    background: linear-gradient(160deg, #160806, #1c0806 60%, #0b0302);
  }

  .page-loader[data-variant="menu"][data-phase="exit"],
  .page-loader[data-variant="menu"][data-phase="done"] {
    transition:
      opacity 500ms cubic-bezier(0.4, 0, 0, 1),
      transform 500ms cubic-bezier(0.4, 0, 0, 1);
  }

  .page-loader__menu-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(251, 191, 36, 0.1);
    box-shadow: 0 0 24px rgba(251, 191, 36, 0.2);
    animation: loader-pulse 1.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    will-change: transform;
    backface-visibility: hidden;
  }

  @keyframes loader-pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }


  [data-scroll-reveal] {
    opacity: 0;
    transform: translate3d(0, 24px, 0) scale(0.96);
    will-change: opacity, transform;
    /* Outro transition - fast and direct */
    transition:
      opacity 380ms cubic-bezier(0.25, 1, 0.5, 1),
      transform 420ms cubic-bezier(0.25, 1, 0.5, 1);
    transition-delay: 0ms !important;
  }

  /* Suspend animations and force hidden state while cinematic loader is active */
  html.is-page-loading [data-scroll-reveal] {
    opacity: 0 !important;
    transform: translate3d(0, 24px, 0) scale(0.96) !important;
    transition: none !important;
  }

  /* Custom entrance for the top bar to preserve backdrop-filter blur */
  html.is-page-loading .customer-nav-wrapper {
    opacity: 0;
  }

  html:not(.is-page-loading) .customer-nav-wrapper {
    animation: nav-enter 850ms cubic-bezier(0.34, 1.45, 0.64, 1) 400ms backwards;
  }

  @keyframes nav-enter {
    from {
      opacity: 0;
      transform: translate3d(0, -16px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  [data-scroll-reveal][data-scroll-visible] {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
