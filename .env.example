# Database (Neon pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Auth (NextAuth v4)
AUTH_SECRET="generate-this-with-openssl-or-node"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Pusher (realtime order updates). NEXT_PUBLIC_* mirror the server values
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# Rate limiter (Upstash Redis): REQUIRED in Vercel production for durable,
# cross-instance limiting. If omitted, the limiter falls back to an in-memory
# Map that only works within a single process (fine for local dev/tests).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Payments (automated gateway). PAYMENT_PROVIDER selects the implementation
# ("mock" is the built-in simulation, "paymongo" is the real GCash gateway).
# PAYMENT_SIGNING_SECRET signs the mock gateway's settlement callbacks.
PAYMENT_PROVIDER="mock"
PAYMENT_SIGNING_SECRET="generate-a-long-random-string"

# PayMongo (only needed when PAYMENT_PROVIDER="paymongo"). Get the keys from the
# PayMongo dashboard under Developers > API Keys. PAYMONGO_WEBHOOK_SECRET is the
# secret of the webhook pointing at /api/payments/webhooks/paymongo. Create it
# via POST /v1/webhooks with the SAME secret key you use here: webhooks are
# scoped to test/live mode, and one made in the Dashboard UI is live-mode, so it
# never fires for sandbox (sk_test_) payments.
PAYMONGO_PUBLIC_KEY=""
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# Storefront
GCASH_NUMBER=""

# Optional: Google sign-in for admin/staff (gated by the User table)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
